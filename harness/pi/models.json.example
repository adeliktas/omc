{
  "providers": {
    "omniroute-api": {
      "api": "openai-completions",
      "baseUrl": "http://localhost:@OMNIROUTE_PORT@/v1",
      "apiKey": "@OMNIROUTE_API_KEY@",
      "models": [
        {
          "id": "@MODEL_ID@",
          "name": "@MODEL_ID@ via OmniRoute",
          "reasoning": true,
          "input": ["text"],
          "contextWindow": 65536,
          "maxTokens": 16384
        }
      ]
    }
  }
}
