# Fleet settings of one OMC instance (rendered by deploy/install.sh; sourced after data/.env).
OMC_HOME=@OMC_HOME@
OMC_DATA=@OMC_DATA@
DOCKER_HOST=@DOCKER_HOST@
PATH=@HOME@/.local/bin:@HOME@/.local/node/bin:@HOME@/.pi/agent/bin:${PATH}  # keeps OpenRC's helpers on PATH
MC_URL=http://127.0.0.1:${BACKEND_PORT}
MC_TOKEN=${LOCAL_AUTH_TOKEN}
RUNNER_BOARD=*
RUNNER_APPLY=1
RUNNER_TEAM_DEPLOY=0
PYTHONDONTWRITEBYTECODE=1
