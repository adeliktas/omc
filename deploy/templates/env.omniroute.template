# OmniRoute settings of this OMC instance, generated by deploy/install.sh. Private: mode 0600.
JWT_SECRET=@JWT@
API_KEY_SECRET=@API_KEY_SECRET@
STORAGE_ENCRYPTION_KEY=@STORAGE_KEY@
STORAGE_ENCRYPTION_KEY_VERSION=v1
INITIAL_PASSWORD=@INITIAL_PASSWORD@
PORT=20128
DASHBOARD_PORT=20128
API_PORT=20129
# The API listener must accept the Compose network (Mission Control calls http://omniroute:20129/v1).
API_HOST=0.0.0.0
# Key rotation must revoke access, not silently fall back to anonymous inference.
REQUIRE_API_KEY=true
OMNIROUTE_ALLOW_PRIVATE_PROVIDER_URLS=true
