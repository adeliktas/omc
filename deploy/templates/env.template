# OMC instance settings, generated by deploy/install.sh. Private: mode 0600, never commit.
COMPOSE_PROJECT_NAME=@PROJECT@
COMPOSE_PROFILES=omniroute
FRONTEND_PORT=@FRONTEND_PORT@
BACKEND_PORT=@BACKEND_PORT@
POSTGRES_PORT=@POSTGRES_PORT@
REDIS_PORT=@REDIS_PORT@
OMNIROUTE_PORT=@OMNIROUTE_PORT@
OMNIROUTE_PORT2=@OMNIROUTE_PORT2@
OMNIROUTE_IMAGE=omniroute:omc-local
# Interface the UI, API and OmniRoute bind to. Loopback keeps them on this host; set 0.0.0.0 (or one
# address) to reach them from another machine, together with BASE_URL/CORS_ORIGINS below.
OMC_BIND_ADDR=127.0.0.1
AUTH_MODE=local
LOCAL_AUTH_TOKEN=@TOKEN@
POSTGRES_PASSWORD=@PGPASS@
BASE_URL=http://localhost:@BACKEND_PORT@
CORS_ORIGINS=http://localhost:@FRONTEND_PORT@
NEXT_PUBLIC_API_URL=auto
OMNIROUTE_URL=http://omniroute:20128
OMNIROUTE_RUNTIME_URL=http://omniroute:20129/v1
# Shared with OmniRoute's JWT_SECRET so the backend can mint its management token.
OMNIROUTE_JWT_SECRET=@JWT@
# An API key you create in this instance's OmniRoute dashboard (deploy/setup.sh step 3 asks for it).
OMNIROUTE_RUNTIME_KEY=
