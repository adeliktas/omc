+              model: lane.PRIVATE_LANE_TARGET,
+              messages: [{ role: "user", content: "synthetic-only" }],
+              stream: false,
+              max_tokens: 1,
+            });
+      client.write(body);
+      await new Promise((r) => setTimeout(r, 11000));
+      console.log(
+        "installed-framework body observations",
+        JSON.stringify({
+          middlewareFinished,
+          handlerEntries,
+          received,
+          dispatches,
+          bytesSent: body.length,
+          waitMs: 11000,
+        })
+      );
+      assert.equal(
+        middlewareFinished,
+        false,
+        "special lane must not enter body-cloning middleware"
+      );
+      assert.equal(handlerEntries, 1, "authenticated streaming handler entered before HTTP EOF");
+      assert.equal(status, 400, "unfinished body refuses without upstream effects");
+      assert.equal(dispatches, 0);
+      assert.equal(
+        received,
+        true,
+        "body deadline must terminate request even before HTTP EOF (not wait for Next finalize)"
+      );
+    } finally {
+      client.end();
+      await Promise.all(works);
+      client.destroy();
+      server.closeAllConnections();
+      await new Promise((r) => server.close(r));
+      console.log("cleanup", JSON.stringify({ handlerEntries, dispatches, errors }));
+    }
+  });
