diff --git a/open-sse/handlers/privateLaneChat.ts b/open-sse/handlers/privateLaneChat.ts
new file mode 100644
index 000000000..0b25f0a1c
--- /dev/null
+++ b/open-sse/handlers/privateLaneChat.ts
@@ -0,0 +1,234 @@
+import http from "node:http";
+import { z } from "zod";
+import { enforceApiKeyPolicy } from "@/shared/utils/apiKeyPolicy";
+import { isModelAllowedForKey, validateApiKey } from "@/lib/db/apiKeys";
+import {
+  requirePrivateLane,
+  PRIVATE_LANE_MODEL,
+  PRIVATE_LANE_TARGET,
+  PRIVATE_LANE_UPSTREAM,
+} from "@/lib/db/privateLane";
+import { errorResponse } from "../utils/error.ts";
+
+const LIMIT = 256 * 1024; // Upstream RESPONSE cap; readBody separately bounds REQUESTS to 64 KiB.
+const headers = { "cache-control": "no-store", "content-type": "application/json" };
+// ponytail: one in-flight request per server process; no claim of reserving unrelated Jetson clients.
+let busy = false;
+const inputSchema = z
+  .object({
+    model: z.literal(PRIVATE_LANE_TARGET),
+    messages: z
+      .array(
+        z
+          .object({
+            role: z.enum(["system", "developer", "user", "assistant"]),
+            content: z.string().max(32768),
+          })
+          .strict()
+      )
+      .min(1)
+      .max(8),
+    stream: z.literal(false),
+    max_tokens: z.number().int().min(1).max(2048),
+    temperature: z.number().min(0).max(1).optional(),
+    chat_template_kwargs: z
+      .object({ enable_thinking: z.literal(true) })
+      .strict()
+      .optional(),
+  })
+  .strict();
+// Known unused SGLang metadata is allowed only when null, then never forwarded.
+const nullMetadata = z
+  .null()
+  .optional()
+  .transform(() => undefined);
+const outputSchema = z.object({
+  model: z.literal(PRIVATE_LANE_MODEL),
+  choices: z
+    .array(
+      z
+        .object({
+          message: z
+            .object({
+              role: z.literal("assistant"),
+              content: z.string().nullable().optional(),
+              reasoning_content: z.string().nullable().optional(),
+              // MC accepts only absent/null tool_calls: zero calls normalize to null, never execute.
+              tool_calls: z
+                .union([z.null(), z.array(z.never()).length(0)])
+                .optional()
+                .transform((value) => (Array.isArray(value) ? null : value)),
+            })
+            .strict(),
+          index: z.number().int().optional(),
+          finish_reason: z
+            .enum(["stop", "length", "content_filter", "abort"])
+            .nullable()
+            .optional(),
+          logprobs: z.null().optional(),
+          matched_stop: z
+            .union([z.null(), z.number().int().nonnegative().safe(), z.string().max(32768)])
+            .optional()
+            .transform(() => undefined),
+          hidden_states: nullMetadata,
+          prompt_token_ids: nullMetadata,
+          response_token_ids: nullMetadata,
+          meta_info: nullMetadata,
+        })
+        .strict()
+    )
+    .length(1),
+  usage: z
+    .object({
+      prompt_tokens: z.number().int().nonnegative(),
+      completion_tokens: z.number().int().nonnegative(),
+      total_tokens: z.number().int().nonnegative(),
+    })
+    .optional(),
+});
+
+async function readBody(request: Request) {
+  if (!request.body) throw new Error("invalid_request");
+  const reader = request.body.getReader();
+  let interrupted = false;
+  const interrupt = () => {
+    interrupted = true;
+    void reader.cancel().catch(() => {});
+  };
+  const timer = setTimeout(interrupt, 10000);
+  request.signal.addEventListener("abort", interrupt, { once: true });
+  const chunks: Uint8Array[] = [];
+  let size = 0;
+  try {
+    while (true) {
+      const { done, value } = await reader.read();
+      if (interrupted || request.signal.aborted) throw new Error("invalid_request");
+      if (done) break;
+      size += value.byteLength;
+      if (size > 65536) {
+        await reader.cancel();
+        throw new Error("invalid_request");
+      }
+      chunks.push(value);
+    }
+    const text = Buffer.concat(chunks).toString("utf8");
+    const body: unknown = JSON.parse(text);
+    if (JSON.stringify(body) !== text) throw new Error("invalid_request");
+    return inputSchema.parse(body);
+  } finally {
+    clearTimeout(timer);
+    request.signal.removeEventListener("abort", interrupt);
+    reader.releaseLock();
+  }
+}
+
+/** This lane deliberately never enters general chat's logs, hooks, caches, tools or fallback. */
+export async function handlePrivateLaneChat(request: Request): Promise<Response> {
+  const refuse = (status: number) => {
+    const response = errorResponse(status, "private_lane_trust_required");
+    response.headers.set("cache-control", "no-store");
+    return response;
+  };
+  try {
+    if (
+      !["GET", "POST"].includes(request.method) ||
+      new URL(request.url).search ||
+      request.headers.get("x-route-model") ||
+      !request.headers.get("authorization")?.startsWith("Bearer ")
+    )
+      return refuse(403);
+    // Check before request payload, any provider credentials, network or general-policy side effects.
+    const lane = requirePrivateLane(
+      request.headers.get("x-omc-model"),
+      request.headers.get("x-omc-source-method")
+    );
+    // This streaming route bypasses middleware cloning, not authoritative authentication.
+    if (!(await validateApiKey(request.headers.get("authorization")!.slice(7).trim())))
+      return refuse(403);
+    const policy = await enforceApiKeyPolicy(
+      // Next preserves original aliases (case/double-prefix). Authorize the concrete chat endpoint.
+      new Request(new URL("/v1/chat/completions", request.url), {
+        method: request.method,
+        headers: { authorization: request.headers.get("authorization")! },
+      }),
+      PRIVATE_LANE_TARGET
+    );
+    const connections = policy.apiKeyInfo?.allowedConnections ?? [];
+    if (
+      policy.rejection ||
+      !policy.apiKeyInfo?.id ||
+      !policy.apiKey ||
+      // Generic routing may defer model authorization to combo/execution. This fixed lane must not.
+      !(await isModelAllowedForKey(policy.apiKey, PRIVATE_LANE_TARGET)) ||
+      (connections.length > 0 && !connections.includes(lane.connectionId))
+    )
+      return refuse(403);
+    if (request.signal.aborted) return refuse(503);
+    if (request.method === "GET")
+      return Response.json({ admitted: true, model: PRIVATE_LANE_TARGET, source_method: "GET" }, { headers });
+    if (busy) return refuse(503);
+    busy = true;
+    try {
+      let input: z.infer<typeof inputSchema>;
+      try {
+        input = await readBody(request);
+      } catch {
+        return refuse(400);
+      }
+      // Recheck after bounded parsing, immediately before the sole fixed local network operation.
+      requirePrivateLane(input.model, "GET");
+      const payload = JSON.stringify({ ...input, model: PRIVATE_LANE_MODEL });
+      const response = await new Promise<unknown>((resolve, reject) => {
+        const req = http.request(
+          PRIVATE_LANE_UPSTREAM,
+          {
+            method: "POST",
+            agent: false,
+            signal: AbortSignal.any([request.signal, AbortSignal.timeout(120000)]),
+            headers: {
+              "content-type": "application/json",
+              "content-length": Buffer.byteLength(payload),
+            },
+          },
+          (res) => {
+            if (res.statusCode !== 200) {
+              res.destroy();
+              reject(new Error("local_unavailable"));
+              return;
+            }
+            let size = 0;
+            const chunks: Buffer[] = [];
+            res.on("data", (chunk: Buffer) => {
+              size += chunk.length;
+              if (size > LIMIT) {
+                res.destroy();
+                reject(new Error("local_unavailable"));
+                return;
+              }
+              chunks.push(chunk);
+            });
+            res.on("error", () => reject(new Error("local_unavailable")));
+            res.on("aborted", () => reject(new Error("local_unavailable")));
+            res.on("end", () => {
+              try {
+                resolve(JSON.parse(Buffer.concat(chunks).toString("utf8")));
+              } catch {
+                reject(new Error("local_unavailable"));
+              }
+            });
+          }
+        );
+        req.on("error", () => reject(new Error("local_unavailable")));
+        req.end(payload);
+      });
+      const output = outputSchema.parse(response);
+      if (!output.choices[0].message.content && !output.choices[0].message.reasoning_content)
+        return refuse(503);
+      return Response.json(output, { headers });
+    } finally {
+      busy = false;
+    }
+  } catch {
+    return refuse(503);
+  }
+}
