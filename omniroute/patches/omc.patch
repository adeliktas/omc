diff --git a/open-sse/utils/responseLifetime.ts b/open-sse/utils/responseLifetime.ts
new file mode 100644
index 0000000000..92dffeb5e1
--- /dev/null
+++ b/open-sse/utils/responseLifetime.ts
@@ -0,0 +1,43 @@
+/** Keep a streaming request's capacity slot until EOF, error or cancellation. */
+export function releaseWhenResponseComplete(response: Response, release: () => void): Response {
+  if (!response.body || !response.headers.get("content-type")?.includes("text/event-stream")) {
+    release();
+    return response;
+  }
+  const reader = response.body.getReader();
+  let released = false;
+  const finish = () => {
+    if (!released) {
+      released = true;
+      release();
+    }
+  };
+  const body = new ReadableStream<Uint8Array>({
+    async pull(controller) {
+      try {
+        const { done, value } = await reader.read();
+        if (done) {
+          finish();
+          controller.close();
+        } else {
+          controller.enqueue(value);
+        }
+      } catch (error) {
+        finish();
+        controller.error(error);
+      }
+    },
+    async cancel(reason) {
+      try {
+        await reader.cancel(reason);
+      } finally {
+        finish();
+      }
+    },
+  });
+  return new Response(body, {
+    status: response.status,
+    statusText: response.statusText,
+    headers: response.headers,
+  });
+}
