+import { getDbInstance } from "./core";
+
+// Set per instance. Unset means the private lane refuses every request.
+export const PRIVATE_LANE_MODEL = process.env.OMC_PRIVATE_LANE_MODEL ?? "";
+export const PRIVATE_LANE_BASE_URL = (process.env.OMC_PRIVATE_LANE_BASE_URL ?? "").replace(/\/+$/, "");
+export const PRIVATE_LANE_TARGET = `vllm/${PRIVATE_LANE_MODEL}`;
+export const PRIVATE_LANE_UPSTREAM = `${PRIVATE_LANE_BASE_URL}/chat/completions`;
+
+/** No credentials selected. This special lane never uses general routing/proxy configuration. */
+export function requirePrivateLane(target: unknown, sourceMethod: unknown) {
+  if (!PRIVATE_LANE_MODEL || !PRIVATE_LANE_BASE_URL) throw new Error("private_lane_trust_required");
+  if (target !== PRIVATE_LANE_TARGET || sourceMethod !== "GET") throw new Error("private_lane_trust_required");
+  const db = getDbInstance();
+  // Do not let the general prefix winner rule turn ambiguity into a security grant.
+  const nodes = db
+    .prepare(
+      "SELECT id,type,base_url,chat_path,custom_headers_json FROM provider_nodes WHERE prefix='vllm'"
+    )
+    .all() as Array<{
+    id: string;
+    type: string;
+    base_url: string;
+    chat_path: string | null;
+    custom_headers_json: string | null;
+  }>;
+  const node = nodes[0];
+  if (
+    nodes.length !== 1 ||
+    node.type !== "openai-compatible" ||
+    node.base_url !== PRIVATE_LANE_BASE_URL ||
+    ![null, "/chat/completions"].includes(node.chat_path) ||
+    ![null, "", "{}"].includes(node.custom_headers_json)
+  )
+    throw new Error("private_lane_trust_required");
+  const flags = db
+    .prepare(
+      "SELECT override_value FROM model_capability_overrides WHERE provider=? AND model_id=? AND override_key='fully_trusted'"
+    )
+    .all(node.id, PRIVATE_LANE_MODEL) as Array<{ override_value: string }>;
+  // Only the canonical literal written by the strict boolean API grants admission.
+  if (flags.length !== 1 || flags[0].override_value !== "true")
+    throw new Error("private_lane_trust_required");
+  const connections = db
+    .prepare("SELECT id FROM provider_connections WHERE provider=? AND is_active=1")
+    .all(node.id) as Array<{ id: string }>;
+  if (connections.length !== 1) throw new Error("private_lane_trust_required");
+  return { provider: node.id, connectionId: connections[0].id, model: PRIVATE_LANE_MODEL };
+}
