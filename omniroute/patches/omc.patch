+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { readFileSync } from 'node:fs';
+
+// ponytail: static contract for the two actual call sites; live/bundled routing
+// needs its own runtime check. No evaluation, fake source execution, or credentials.
+const source = readFileSync(new URL('../../open-sse/handlers/chatCore.ts', import.meta.url), 'utf8');
+for (const provider of ['codex', 'antigravity']) {
+  const call = source.match(new RegExp(`await getProviderCredentials\\(\\s*"${provider}",([\\s\\S]*?)\\)\\.catch\\(\\(\\) => null\\)`));
+  assert.ok(call, `${provider} real inner selector call exists`);
+  test(`${provider} inner retry retains key policy, requested model, and excluded accounts`, () => {
+    const excluded = provider === 'codex' ? 'codexExcludedIds' : 'antigravityByopExcludedIds';
+    assert.equal(call[1].replace(/\s+/g, '').replace(/,}/g, '}'),
+      `null,apiKeyInfo?.allowedConnections??null,modelToCall||model||requestedModel||null,{excludeConnectionIds:[...${excluded}]}`);
+  });
+}
