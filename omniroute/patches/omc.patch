diff --git a/tests/unit/response-lifetime.test.ts b/tests/unit/response-lifetime.test.ts
new file mode 100644
index 0000000000..69ad30d734
--- /dev/null
+++ b/tests/unit/response-lifetime.test.ts
@@ -0,0 +1,129 @@
+import assert from "node:assert/strict";
+import fs from "node:fs";
+import os from "node:os";
+import path from "node:path";
+import test from "node:test";
+
+process.env.DATA_DIR = fs.mkdtempSync(path.join(os.tmpdir(), "omniroute-response-lifetime-"));
+const { releaseWhenResponseComplete } = await import("../../open-sse/utils/responseLifetime.ts");
+const { handleComboChat } = await import("../../open-sse/services/combo.ts");
+
+const sse = { "content-type": "text/event-stream" };
+
+test("stream capacity survives headers and releases once on EOF, cancel or error", async () => {
+  let releases = 0;
+  const release = () => {
+    releases++;
+  };
+  let upstream!: ReadableStreamDefaultController<Uint8Array>;
+  const response = releaseWhenResponseComplete(
+    new Response(
+      new ReadableStream({
+        start(controller) {
+          upstream = controller;
+        },
+      }),
+      { headers: sse }
+    ),
+    release
+  );
+  assert.equal(releases, 0);
+  const reader = response.body!.getReader();
+  upstream.enqueue(new TextEncoder().encode("data: OK\n\n"));
+  await reader.read();
+  assert.equal(releases, 0);
+  upstream.close();
+  assert.equal((await reader.read()).done, true);
+  assert.equal(releases, 1);
+  await reader.cancel();
+  assert.equal(releases, 1);
+
+  let cancelled = false;
+  const cancelledResponse = releaseWhenResponseComplete(
+    new Response(
+      new ReadableStream({
+        cancel() {
+          cancelled = true;
+        },
+      }),
+      { headers: sse }
+    ),
+    release
+  );
+  await cancelledResponse.body!.cancel();
+  assert.equal(cancelled, true);
+  assert.equal(releases, 2);
+
+  const failedResponse = releaseWhenResponseComplete(
+    new Response(
+      new ReadableStream({
+        start(controller) {
+          controller.error(new Error("upstream failed"));
+        },
+      }),
+      { headers: sse }
+    ),
+    release
+  );
+  await assert.rejects(failedResponse.text(), /upstream failed/);
+  assert.equal(releases, 3);
+  releaseWhenResponseComplete(new Response("OK"), release);
+  assert.equal(releases, 4);
+});
+
+test("round-robin holds a streaming target's concurrency slot until its body ends", async () => {
+  const encoder = new TextEncoder();
+  const chunk = (data: unknown) => encoder.encode(`data: ${JSON.stringify(data)}\n\n`);
+  const content = chunk({ choices: [{ index: 0, delta: { content: "hello" } }] });
+  let finishFirst!: () => void;
+  const openStream = () =>
+    new Response(
+      new ReadableStream<Uint8Array>({
+        start(controller) {
+          controller.enqueue(content);
+          finishFirst = () => {
+            controller.enqueue(encoder.encode("data: [DONE]\n\n"));
+            controller.close();
+          };
+        },
+      }),
+      { status: 200, headers: sse }
+    );
+  const closedStream = () =>
+    new Response(
+      new ReadableStream<Uint8Array>({
+        start(controller) {
+          controller.enqueue(content);
+          controller.enqueue(encoder.encode("data: [DONE]\n\n"));
+          controller.close();
+        },
+      }),
+      { status: 200, headers: sse }
+    );
+  const call = (handleSingleModel: () => Promise<Response>) =>
+    handleComboChat({
+      body: { stream: true },
+      combo: {
+        name: "rr-stream-slot",
+        strategy: "round-robin",
+        models: ["model-a"],
+        config: { maxRetries: 0, concurrencyPerModel: 1, queueTimeoutMs: 100 },
+      },
+      handleSingleModel,
+      isModelAvailable: async () => true,
+      log: { info() {}, warn() {}, error() {}, debug() {} },
+      settings: null,
+      allCombos: null,
+    });
+
+  const first = await call(async () => openStream());
+  assert.equal(first.ok, true);
+  const whileStreaming = await call(async () => closedStream());
+  assert.equal(whileStreaming.ok, false, "the slot is still held by the open stream");
+
+  finishFirst();
+  assert.match(await first.text(), /hello/);
+  const afterEof = await call(async () => closedStream());
+  assert.equal(afterEof.ok, true, "EOF released the slot");
+  await afterEof.text();
+});
