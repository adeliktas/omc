+++ b/tests/unit/private-lane-framework-body.test.mjs
@@ -0,0 +1,230 @@
+// Adapted from retained Sol V3 probe: select middleware using the ACTUAL installed Next matcher.
+// The original forced-middleware probe is unchanged in review evidence; its body-refusal assertion remains here.
+import { test, after } from "node:test";
+import assert from "node:assert/strict";
+import http from "node:http";
+import { once } from "node:events";
+import { mkdtempSync, rmSync, mkdirSync, writeFileSync } from "node:fs";
+import path from "node:path";
+import os from "node:os";
+import { pathToFileURL } from "node:url";
+const load = (p) => import(pathToFileURL(path.join(process.cwd(), p)).href);
+const dir = mkdtempSync(path.join(os.tmpdir(), "sol-v3-framework-"));
+process.env.DATA_DIR = dir;
+process.env.OMC_PRIVATE_LANE_MODEL = "Qwen3.8-27B-FP8";
+process.env.OMC_PRIVATE_LANE_BASE_URL = "http://192.0.2.10:8000/v1";
+process.env.API_KEY_SECRET = "synthetic-v3-framework-only";
+process.env.REQUIRE_API_KEY = "true";
+process.env.REDIS_URL = "";
+const core = await load("src/lib/db/core.ts");
+const keys = await load("src/lib/db/apiKeys.ts");
+const nodes = await load("src/lib/db/providers/nodes.ts");
+const flags = await load("src/lib/db/modelCapabilityOverrides.ts");
+const lane = await load("src/lib/db/privateLane.ts");
+const route = await load("src/app/api/v1/private/chat/completions/route.ts");
+const { runAuthzPipeline } = await load("src/server/authz/pipeline.ts");
+const { config } = await load("src/proxy.ts");
+const { getMiddlewareMatchers } = await load(
+  "node_modules/next/dist/build/analysis/get-page-static-info.js"
+);
+const { getMiddlewareRouteMatcher } = await load(
+  "node_modules/next/dist/shared/lib/router/utils/middleware-route-matcher.js"
+);
+const matchers = getMiddlewareMatchers(config.matcher, { basePath: "" });
+const match = getMiddlewareRouteMatcher(matchers);
+await load("node_modules/next/dist/server/node-environment.js");
+const { setupFsCheck } = await load("node_modules/next/dist/server/lib/router-utils/filesystem.js");
+const discovery = path.join(dir, "discovery"),
+  canonical = "/api/v1/private/chat/completions";
+function put(file, data) {
+  const p = path.join(discovery, ".next", file);
+  mkdirSync(path.dirname(p), { recursive: true });
+  writeFileSync(p, typeof data === "string" ? data : JSON.stringify(data));
+}
+put("BUILD_ID", "synthetic-only");
+put("routes-manifest.json", {
+  dataRoutes: [],
+  dynamicRoutes: [],
+  redirects: [],
+  headers: [],
+  onMatchHeaders: [],
+  rewrites: { beforeFiles: [], afterFiles: [], fallback: [] },
+});
+put("prerender-manifest.json", { preview: { previewModeId: "synthetic-preview-id" } });
+// Next >= 16.4 reads preview props from their own server manifest.
+put("server/preview-props.json", { previewModeId: "synthetic-preview-id" });
+put("server/pages-manifest.json", {});
+put("server/functions-config-manifest.json", { functions: { "/_middleware": { matchers } } });
+put("app-path-routes-manifest.json", { [canonical + "/route"]: canonical });
+const filesystem = await setupFsCheck({
+  dev: false,
+  dir: discovery,
+  config: { distDir: ".next", basePath: "", output: "standalone", experimental: {} },
+});
+const { default: serverModule } = await load("node_modules/next/dist/server/next-server.js");
+const NextServer = serverModule.default ?? serverModule;
+const { adapter } = await load("node_modules/next/dist/server/web/adapter.js");
+const { getCloneableBody } = await load("node_modules/next/dist/server/body-streams.js");
+const { NodeNextRequest, NodeNextResponse } = await load(
+  "node_modules/next/dist/server/base-http/node.js"
+);
+const { addRequestMeta } = await load("node_modules/next/dist/server/request-meta.js");
+const { NextRequestAdapter, signalFromNodeResponse } = await load(
+  "node_modules/next/dist/server/web/spec-extension/adapters/next-request.js"
+);
+after(() => {
+  core.resetDbInstance();
+  rmSync(dir, { recursive: true, force: true });
+});
+const provider = "openai-compatible-chat-v4-framework";
+await nodes.createProviderNode({
+  id: provider,
+  prefix: "vllm",
+  name: "Synthetic",
+  type: "openai-compatible",
+  baseUrl: "http://192.0.2.10:8000/v1",
+});
+core
+  .getDbInstance()
+  .prepare(
+    "INSERT INTO provider_connections (id,provider,is_active,created_at,updated_at) VALUES (?,?,1,datetime('now'),datetime('now'))"
+  )
+  .run("synthetic-v4-connection", provider);
+flags.setModelCapabilityOverride(`${provider}/${lane.PRIVATE_LANE_MODEL}`, "fully_trusted", true);
+const key = await keys.createApiKey("Synthetic v4", "synthetic-machine");
+for (const [upload, pathname] of [
+  ["oversized", "/v1/private/chat/completions"],
+  ["unfinished-valid-prefix", "/v1/private/chat/completions"],
+  ["oversized", "/api/v1/%70rivate/chat/completions"],
+  ["unfinished-valid-prefix", "/api/v1/private%2fchat/completions"],
+])
+  test(`private-lane actual framework selection refuses ${upload} on ${pathname} before EOF`, async (t) => {
+    let handlerEntries = 0,
+      middlewareFinished = false,
+      dispatches = 0,
+      received = false,
+      status = 0;
+    const native = http.request;
+    t.mock.method(http, "request", () => {
+      dispatches++;
+      throw new Error("no real dispatch authorized");
+    });
+    const middlewareModule = {
+      default: adapter,
+      proxy: async (r) => {
+        const result = await runAuthzPipeline(r, { enforce: true });
+        assert.equal(result.headers.get("x-middleware-next"), "1");
+        middlewareFinished = true;
+        return result;
+      },
+    };
+    // Build/module discovery alone is stubbed; installed Next runMiddleware/adapter/body finalization execute.
+    const facade = {
+      renderOpts: { previewProps: { previewModeId: "synthetic-nonempty-preview-id" } },
+      nextConfig: {
+        skipProxyUrlNormalize: true,
+        basePath: "",
+        experimental: { proxyClientMaxBodySize: 512 * 1024 * 1024 },
+      },
+      dev: true,
+      getMiddleware: async () => ({ page: "/src/proxy" }),
+      hasMiddleware: async () => true,
+      ensureMiddleware: async () => {},
+      getEdgeFunctionInfo: () => undefined,
+      loadNodeMiddleware: async () => middlewareModule,
+      getWaitUntil: () => undefined,
+    };
+    const works = [];
+    const errors = [];
+    const server = http.createServer((incoming, outgoing) => {
+      const request = new NodeNextRequest(incoming),
+        response = new NodeNextResponse(outgoing);
+      addRequestMeta(request, "initURL", `http://localhost${incoming.url}`);
+      addRequestMeta(request, "clonableBody", getCloneableBody(incoming, 512 * 1024 * 1024));
+      const work = (async () => {
+        // Mirrors Next's pre-runMiddleware matcher selection; private-lane is independently authenticated in its handler.
+        if (
+          match(incoming.url, incoming, {}) ||
+          match(decodeURIComponent(incoming.url), incoming, {})
+        )
+          await NextServer.prototype.runMiddleware.call(facade, {
+            request,
+            response,
+            parsed: { pathname: incoming.url, query: {} },
+          });
+        if (pathname.startsWith("/api/"))
+          assert.equal((await filesystem.getItem(pathname))?.itemPath, canonical);
+        handlerEntries++;
+        const r = NextRequestAdapter.fromNodeNextRequest(request, signalFromNodeResponse(outgoing));
+        const result = await route.POST(r);
+        outgoing.writeHead(result.status, Object.fromEntries(result.headers));
+        outgoing.end(await result.text());
+      })().catch((e) => {
+        errors.push(e.name);
+        outgoing.destroy();
+      });
+      works.push(work);
+    });
+    server.listen(0, "127.0.0.1");
+    await once(server, "listening");
+    const client = native.call(http, `http://127.0.0.1:${server.address().port}${pathname}`, {
+      method: "POST",
+      headers: {
+        authorization: `Bearer ${key.key}`,
+        "x-omc-model": lane.PRIVATE_LANE_TARGET,
+        "x-omc-source-method": "GET",
+        "content-type": "application/json",
+      },
+    });
+    client.on("error", () => {});
+    client.on("response", (r) => {
+      received = true;
+      status = r.statusCode;
+      r.resume();
+    });
+    try {
+      // Keep HTTP body unfinished for both the byte-cap and real 10-second deadline probe.
+      const body =
+        upload === "oversized"
+          ? "x".repeat(96 * 1024)
+          : JSON.stringify({
+              model: lane.PRIVATE_LANE_TARGET,
+              messages: [{ role: "user", content: "synthetic-only" }],
+              stream: false,
+              max_tokens: 1,
+            });
+      client.write(body);
+      await new Promise((r) => setTimeout(r, 11000));
+      console.log(
+        "installed-framework body observations",
+        JSON.stringify({
+          middlewareFinished,
+          handlerEntries,
+          received,
+          dispatches,
+          bytesSent: body.length,
+          waitMs: 11000,
+        })
+      );
+      assert.equal(
+        middlewareFinished,
+        false,
+        "special lane must not enter body-cloning middleware"
+      );
+      assert.equal(handlerEntries, 1, "authenticated streaming handler entered before HTTP EOF");
+      assert.equal(status, 400, "unfinished body refuses without upstream effects");
+      assert.equal(dispatches, 0);
+      assert.equal(
+        received,
+        true,
+        "body deadline must terminate request even before HTTP EOF (not wait for Next finalize)"
+      );
+    } finally {
+      client.end();
+      await Promise.all(works);
+      client.destroy();
+      server.closeAllConnections();
+      await new Promise((r) => server.close(r));
+      console.log("cleanup", JSON.stringify({ handlerEntries, dispatches, errors }));
+    }
+  });
diff --git a/tests/unit/private-lane-fully-trusted.test.ts b/tests/unit/private-lane-fully-trusted.test.ts
new file mode 100644
index 0000000000..9c93125e05
--- /dev/null
+++ b/tests/unit/private-lane-fully-trusted.test.ts
@@ -0,0 +1,147 @@
+import { after, beforeEach, test } from "node:test";
+import assert from "node:assert/strict";
+import { mkdirSync, mkdtempSync, rmSync } from "node:fs";
+import os from "node:os";
+import path from "node:path";
+
+const dir = mkdtempSync(path.join(os.tmpdir(), "private-lane-trust-"));
+process.env.DATA_DIR = dir;
+process.env.OMC_PRIVATE_LANE_MODEL = "Qwen3.8-27B-FP8";
+process.env.OMC_PRIVATE_LANE_BASE_URL = "http://192.0.2.10:8000/v1";
+const core = await import("../../src/lib/db/core.ts");
+const overrides = await import("../../src/lib/db/modelCapabilityOverrides.ts");
+const nodes = await import("../../src/lib/db/providers/nodes.ts");
+const route = await import("../../src/app/api/model-capability-overrides/route.ts");
+const lane = await import("../../src/lib/db/privateLane.ts");
+const provider = "openai-compatible-chat-private-lane-test";
+const model = "Qwen3.8-27B-FP8";
+
+beforeEach(async () => {
+  core.resetDbInstance();
+  rmSync(dir, { recursive: true, force: true });
+  mkdirSync(dir, { recursive: true });
+  await nodes.createProviderNode({
+    id: provider,
+    prefix: "vllm",
+    name: "Local",
+    type: "openai-compatible",
+    baseUrl: "http://192.0.2.10:8000/v1",
+  });
+  core
+    .getDbInstance()
+    .prepare(
+      "INSERT INTO provider_connections (id,provider,is_active,created_at,updated_at) VALUES (?,?,1,datetime('now'),datetime('now'))"
+    )
+    .run("local-connection", provider);
+});
+after(() => {
+  core.resetDbInstance();
+  rmSync(dir, { recursive: true, force: true });
+});
+
+function set(value: unknown) {
+  return overrides.setModelCapabilityOverride(
+    `${provider}/${model}`,
+    "fully_trusted",
+    value as boolean
+  );
+}
+function admit(target = `vllm/${model}`, method = "GET") {
+  return lane.requirePrivateLane(target, method);
+}
+
+test("default/missing, unflagged, false, unknown/string/corrupt trust all deny", () => {
+  assert.throws(() => admit());
+  assert.equal(set(false), true);
+  assert.throws(() => admit());
+  for (const value of ["true", 1, null, {}, [true]]) assert.equal(set(value), false);
+  core
+    .getDbInstance()
+    .prepare("UPDATE model_capability_overrides SET override_value=?")
+    .run('"true"');
+  assert.throws(() => admit());
+  core
+    .getDbInstance()
+    .prepare("UPDATE model_capability_overrides SET override_value=?")
+    .run('{"value":false,"value":true}');
+  assert.throws(() => admit());
+  overrides.setModelCapabilityOverride(`${provider}/${model}`, "max_output_tokens", 2048);
+  assert.throws(() => admit(), "unrelated ordinary writer cannot normalize a denied trust row");
+});
+
+test("literal true admits only exact local node/model and GET Jira intent", () => {
+  assert.equal(set(true), true);
+  assert.deepEqual(admit(), { provider, connectionId: "local-connection", model });
+  for (const target of [
+    "openai/gpt-4o",
+    `codex/${model}`,
+    `vllm/${model}-other`,
+    `${provider}/${model}`,
+    "auto",
+  ])
+    assert.throws(() => admit(target));
+  for (const method of ["POST", "PATCH", "DELETE", "get", ""])
+    assert.throws(() => admit(undefined, method));
+  assert.equal(overrides.setModelCapabilityOverride("openai/gpt-4o", "fully_trusted", true), true);
+  assert.throws(() => admit("openai/gpt-4o"));
+});
+
+test("wrong endpoint, inactive/multiple connections and ambiguous prefix refuse", async () => {
+  set(true);
+  const db = core.getDbInstance();
+  db.prepare("UPDATE provider_nodes SET base_url=?").run("https://example.invalid/v1");
+  assert.throws(() => admit());
+  db.prepare("UPDATE provider_nodes SET base_url=?").run("http://192.0.2.10:8000/v1");
+  db.prepare("UPDATE provider_connections SET is_active=0").run();
+  assert.throws(() => admit());
+  db.prepare("UPDATE provider_connections SET is_active=1").run();
+  db.prepare(
+    "INSERT INTO provider_connections (id,provider,is_active,created_at,updated_at) VALUES (?,?,1,datetime('now'),datetime('now'))"
+  ).run("other", provider);
+  assert.throws(() => admit());
+  db.prepare("DELETE FROM provider_connections WHERE id='other'").run();
+  await nodes.createProviderNode({
+    id: "other-node",
+    prefix: "vllm",
+    name: "Other",
+    type: "openai-compatible",
+    baseUrl: "http://192.0.2.10:8000/v1",
+  });
+  assert.throws(() => admit());
+});
+
+test("management API strict bool, default false, canonical duplicate rejection and delete", async () => {
+  const patch = (body: string) =>
+    route.PATCH(
+      new Request("http://localhost/api/model-capability-overrides", {
+        method: "PATCH",
+        headers: { "content-type": "application/json" },
+        body,
+      })
+    );
+  for (const value of ["true", 1, null])
+    assert.equal(
+      (await patch(JSON.stringify({ target: `vllm/${model}`, key: "fully_trusted", value })))
+        .status,
+      400
+    );
+  assert.equal(
+    (await patch(`{"target":"vllm/${model}","key":"fully_trusted","value":false,"value":true}`))
+      .status,
+    400
+  );
+  assert.throws(() => admit());
+  assert.equal(
+    (await patch(JSON.stringify({ target: `vllm/${model}`, key: "fully_trusted", value: true })))
+      .status,
+    200
+  );
+  assert.equal(admit().provider, provider);
+  const removed = await route.DELETE(
+    new Request(
+      `http://localhost/api/model-capability-overrides?target=vllm/${model}&key=fully_trusted`
+    )
+  );
+  assert.equal(removed.status, 200);
+  assert.throws(() => admit());
+});
diff --git a/tests/unit/prompt-aware-routing.test.ts b/tests/unit/prompt-aware-routing.test.ts
new file mode 100644
index 0000000000..6e18312042
--- /dev/null
+++ b/tests/unit/prompt-aware-routing.test.ts
@@ -0,0 +1,233 @@
+import { test, after } from "node:test";
+import assert from "node:assert/strict";
+import { mkdtempSync, rmSync } from "node:fs";
+import { tmpdir } from "node:os";
+import { join } from "node:path";
+
+const dir = mkdtempSync(join(tmpdir(), "prompt-routing-"));
+process.env.DATA_DIR = dir;
+const { resetDbInstance } = await import("@/lib/db/core.ts");
+const { orderPromptAwareTargets } =
+  await import("@omniroute/open-sse/services/combo/promptAwareRouting.ts");
+const { resolveAutoStrategyOrder } =
+  await import("@omniroute/open-sse/services/combo/resolveAutoStrategy.ts");
+const { rrCounters } = await import("@omniroute/open-sse/services/combo/rrState.ts");
+const { setUserFitnessOverride, clearUserFitnessOverride } =
+  await import("@omniroute/open-sse/services/autoCombo/taskFitness.ts");
+const { normalizeScoringWeights } =
+  await import("@omniroute/open-sse/services/autoCombo/scoring.ts");
+const { mapIntentToTaskType } = await import("@omniroute/open-sse/services/combo/autoStrategy.ts");
+const { classifyWithConfig } = await import("@omniroute/open-sse/services/intentClassifier.ts");
+import type {
+  AutoProviderCandidate,
+  ResolvedComboTarget,
+} from "@omniroute/open-sse/services/combo/types.ts";
+import type { ScoringWeights } from "@omniroute/open-sse/services/autoCombo/scoring.ts";
+
+after(() => {
+  resetDbInstance();
+  rmSync(dir, { recursive: true, force: true });
+});
+const target = (provider: string, model: string, connectionId = provider): ResolvedComboTarget => ({
+  kind: "model",
+  stepId: connectionId,
+  executionKey: `${provider}/${model}@${connectionId}`,
+  modelStr: `${provider}/${model}`,
+  provider,
+  providerId: provider,
+  connectionId,
+  weight: 1,
+  label: null,
+});
+const targets = [
+  target("codex", "gpt-5.5"),
+  target("bridge", "sonnet"),
+  target("neuralwatt", "glm-5.3-flash"),
+];
+const candidate = (t: ResolvedComboTarget): AutoProviderCandidate => ({
+  ...t,
+  model: t.modelStr.split("/").slice(1).join("/"),
+  quotaRemaining: 100,
+  quotaTotal: 100,
+  circuitBreakerState: "CLOSED",
+  costPer1MTokens: 1,
+  p95LatencyMs: 100,
+  latencyStdDev: 0,
+  errorRate: 0,
+});
+const base = () => ({
+  comboName: "test",
+  targets,
+  candidates: targets.map(candidate),
+  intent: "code",
+  intentEnabled: true,
+  taskType: "coding",
+  weights: normalizeScoringWeights({ taskFit: 1 } as ScoringWeights),
+});
+
+test("same eligible pool chooses code specialist vs analysis model based on prompt intent", (t) => {
+  // v3.8.54 (#11503) dropped version-less family rows from the static fitness
+  // table, so the per-task preference comes from explicit fitness data here.
+  setUserFitnessOverride("gpt-5.5", "coding", 0.9);
+  setUserFitnessOverride("sonnet", "analysis", 0.9);
+  t.after(() => {
+    clearUserFitnessOverride("gpt-5.5", "coding");
+    clearUserFitnessOverride("sonnet", "analysis");
+  });
+  const coding = orderPromptAwareTargets(base());
+  const analysis = orderPromptAwareTargets({
+    ...base(),
+    intent: "reasoning",
+    taskType: "analysis",
+  });
+  assert.equal(coding.targets[0].provider, "codex");
+  assert.equal(analysis.targets[0].provider, "bridge");
+  assert.match(coding.reason, /prompt-aware/);
+  assert.equal(new Set(coding.targets.map((t) => t.executionKey)).size, targets.length);
+});
+test("math maps to analysis rather than generic default", () => {
+  assert.equal(mapIntentToTaskType("math"), "analysis");
+});
+test("unknown or disabled classification rotates the same pool", () => {
+  rrCounters.clear();
+  const a = orderPromptAwareTargets({ ...base(), intent: "medium" });
+  const b = orderPromptAwareTargets({ ...base(), intentEnabled: false });
+  assert.equal(a.targets[0].provider, "codex");
+  assert.equal(b.targets[0].provider, "bridge");
+  assert.match(b.reason, /round-robin/);
+});
+test("scoring failure rotates without returning blocked quotas or injected account", () => {
+  rrCounters.clear();
+  const input = base();
+  input.candidates[0].quotaCutoffBlocked = true;
+  input.candidates.push(candidate(target("unapproved", "model")));
+  const decision = orderPromptAwareTargets(input, () => {
+    throw new Error("scoring unavailable");
+  });
+  assert.deepEqual(
+    decision.targets.map((t) => t.provider),
+    ["bridge", "neuralwatt"]
+  );
+});
+test("empty/invalid scorer result falls back safely", () => {
+  assert.match(orderPromptAwareTargets(base(), () => []).reason, /round-robin/);
+  assert.match(
+    orderPromptAwareTargets(base(), () => [{ target: target("evil", "unknown"), score: 99 }])
+      .reason,
+    /round-robin/
+  );
+});
+test("round-robin tail remains after prompt-selected primary", () => {
+  rrCounters.clear();
+  const first = orderPromptAwareTargets(base());
+  const second = orderPromptAwareTargets(base());
+  assert.equal(first.targets[0].provider, "codex");
+  assert.equal(second.targets[0].provider, "codex");
+  assert.equal(first.targets.length, 3);
+});
+test("strict budget rejection is not caught as round-robin fallback", () => {
+  assert.throws(
+    () => orderPromptAwareTargets({ ...base(), budgetCap: 0.00001, budgetFallback: "strict" }),
+    /budget/i
+  );
+});
+test("budget excludes unaffordable smarter target", () => {
+  const input = base();
+  input.candidates[0].costPer1MTokens = 100;
+  const result = orderPromptAwareTargets({ ...input, budgetCap: 0.002, budgetFallback: "strict" });
+  assert.ok(result.targets.every((t) => t.provider !== "codex"));
+});
+test("account pin cannot be broadened by scorer/candidate builder", () => {
+  const t = target("codex", "gpt-5.5", "approved-account");
+  const result = orderPromptAwareTargets({
+    ...base(),
+    targets: [t],
+    candidates: [candidate(target("codex", "gpt-5.5", "other-account"))],
+  });
