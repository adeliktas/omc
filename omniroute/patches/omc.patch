+      ensureMiddleware: async () => {},
+      getEdgeFunctionInfo: () => undefined,
+      loadNodeMiddleware: async () => middlewareModule,
+      getWaitUntil: () => undefined,
+    };
+    const works = [];
+    const errors = [];
+    const server = http.createServer((incoming, outgoing) => {
+      const request = new NodeNextRequest(incoming),
+        response = new NodeNextResponse(outgoing);
+      addRequestMeta(request, "initURL", `http://localhost${incoming.url}`);
+      addRequestMeta(request, "clonableBody", getCloneableBody(incoming, 512 * 1024 * 1024));
+      const work = (async () => {
+        // Mirrors Next's pre-runMiddleware matcher selection; private-lane is independently authenticated in its handler.
+        if (
+          match(incoming.url, incoming, {}) ||
+          match(decodeURIComponent(incoming.url), incoming, {})
+        )
+          await NextServer.prototype.runMiddleware.call(facade, {
+            request,
+            response,
+            parsed: { pathname: incoming.url, query: {} },
+          });
+        if (pathname.startsWith("/api/"))
+          assert.equal((await filesystem.getItem(pathname))?.itemPath, canonical);
+        handlerEntries++;
+        const r = NextRequestAdapter.fromNodeNextRequest(request, signalFromNodeResponse(outgoing));
+        const result = await route.POST(r);
+        outgoing.writeHead(result.status, Object.fromEntries(result.headers));
+        outgoing.end(await result.text());
+      })().catch((e) => {
+        errors.push(e.name);
+        outgoing.destroy();
+      });
+      works.push(work);
+    });
+    server.listen(0, "127.0.0.1");
+    await once(server, "listening");
+    const client = native.call(http, `http://127.0.0.1:${server.address().port}${pathname}`, {
+      method: "POST",
+      headers: {
+        authorization: `Bearer ${key.key}`,
+        "x-omc-model": lane.PRIVATE_LANE_TARGET,
+        "x-omc-source-method": "GET",
+        "content-type": "application/json",
+      },
+    });
+    client.on("error", () => {});
+    client.on("response", (r) => {
+      received = true;
+      status = r.statusCode;
+      r.resume();
+    });
+    try {
+      // Keep HTTP body unfinished for both the byte-cap and real 10-second deadline probe.
+      const body =
+        upload === "oversized"
+          ? "x".repeat(96 * 1024)
