@@ -0,0 +1,147 @@
+import { after, beforeEach, test } from "node:test";
+import assert from "node:assert/strict";
+import { mkdirSync, mkdtempSync, rmSync } from "node:fs";
+import os from "node:os";
+import path from "node:path";
+
+const dir = mkdtempSync(path.join(os.tmpdir(), "private-lane-trust-"));
+process.env.DATA_DIR = dir;
+process.env.OMC_PRIVATE_LANE_MODEL = "Qwen3.8-27B-FP8";
+process.env.OMC_PRIVATE_LANE_BASE_URL = "http://192.0.2.10:8000/v1";
+const core = await import("../../src/lib/db/core.ts");
+const overrides = await import("../../src/lib/db/modelCapabilityOverrides.ts");
+const nodes = await import("../../src/lib/db/providers/nodes.ts");
+const route = await import("../../src/app/api/model-capability-overrides/route.ts");
+const lane = await import("../../src/lib/db/privateLane.ts");
+const provider = "openai-compatible-chat-private-lane-test";
+const model = "Qwen3.8-27B-FP8";
+
+beforeEach(async () => {
+  core.resetDbInstance();
+  rmSync(dir, { recursive: true, force: true });
+  mkdirSync(dir, { recursive: true });
+  await nodes.createProviderNode({
+    id: provider,
+    prefix: "vllm",
+    name: "Local",
+    type: "openai-compatible",
+    baseUrl: "http://192.0.2.10:8000/v1",
+  });
+  core
+    .getDbInstance()
+    .prepare(
+      "INSERT INTO provider_connections (id,provider,is_active,created_at,updated_at) VALUES (?,?,1,datetime('now'),datetime('now'))"
+    )
+    .run("local-connection", provider);
+});
+after(() => {
+  core.resetDbInstance();
+  rmSync(dir, { recursive: true, force: true });
+});
+
+function set(value: unknown) {
+  return overrides.setModelCapabilityOverride(
+    `${provider}/${model}`,
+    "fully_trusted",
+    value as boolean
+  );
+}
+function admit(target = `vllm/${model}`, method = "GET") {
+  return lane.requirePrivateLane(target, method);
+}
+
+test("default/missing, unflagged, false, unknown/string/corrupt trust all deny", () => {
+  assert.throws(() => admit());
+  assert.equal(set(false), true);
+  assert.throws(() => admit());
+  for (const value of ["true", 1, null, {}, [true]]) assert.equal(set(value), false);
+  core
+    .getDbInstance()
+    .prepare("UPDATE model_capability_overrides SET override_value=?")
+    .run('"true"');
+  assert.throws(() => admit());
+  core
+    .getDbInstance()
+    .prepare("UPDATE model_capability_overrides SET override_value=?")
+    .run('{"value":false,"value":true}');
+  assert.throws(() => admit());
+  overrides.setModelCapabilityOverride(`${provider}/${model}`, "max_output_tokens", 2048);
+  assert.throws(() => admit(), "unrelated ordinary writer cannot normalize a denied trust row");
+});
+
+test("literal true admits only exact local node/model and GET Jira intent", () => {
+  assert.equal(set(true), true);
+  assert.deepEqual(admit(), { provider, connectionId: "local-connection", model });
+  for (const target of [
+    "openai/gpt-4o",
+    `codex/${model}`,
+    `vllm/${model}-other`,
+    `${provider}/${model}`,
+    "auto",
+  ])
+    assert.throws(() => admit(target));
+  for (const method of ["POST", "PATCH", "DELETE", "get", ""])
+    assert.throws(() => admit(undefined, method));
+  assert.equal(overrides.setModelCapabilityOverride("openai/gpt-4o", "fully_trusted", true), true);
+  assert.throws(() => admit("openai/gpt-4o"));
+});
+
+test("wrong endpoint, inactive/multiple connections and ambiguous prefix refuse", async () => {
+  set(true);
+  const db = core.getDbInstance();
+  db.prepare("UPDATE provider_nodes SET base_url=?").run("https://example.invalid/v1");
+  assert.throws(() => admit());
+  db.prepare("UPDATE provider_nodes SET base_url=?").run("http://192.0.2.10:8000/v1");
+  db.prepare("UPDATE provider_connections SET is_active=0").run();
+  assert.throws(() => admit());
+  db.prepare("UPDATE provider_connections SET is_active=1").run();
+  db.prepare(
+    "INSERT INTO provider_connections (id,provider,is_active,created_at,updated_at) VALUES (?,?,1,datetime('now'),datetime('now'))"
+  ).run("other", provider);
+  assert.throws(() => admit());
+  db.prepare("DELETE FROM provider_connections WHERE id='other'").run();
+  await nodes.createProviderNode({
+    id: "other-node",
+    prefix: "vllm",
+    name: "Other",
+    type: "openai-compatible",
+    baseUrl: "http://192.0.2.10:8000/v1",
+  });
+  assert.throws(() => admit());
+});
+
+test("management API strict bool, default false, canonical duplicate rejection and delete", async () => {
+  const patch = (body: string) =>
+    route.PATCH(
+      new Request("http://localhost/api/model-capability-overrides", {
+        method: "PATCH",
+        headers: { "content-type": "application/json" },
+        body,
+      })
+    );
+  for (const value of ["true", 1, null])
+    assert.equal(
+      (await patch(JSON.stringify({ target: `vllm/${model}`, key: "fully_trusted", value })))
+        .status,
+      400
+    );
+  assert.equal(
+    (await patch(`{"target":"vllm/${model}","key":"fully_trusted","value":false,"value":true}`))
+      .status,
+    400
+  );
+  assert.throws(() => admit());
+  assert.equal(
+    (await patch(JSON.stringify({ target: `vllm/${model}`, key: "fully_trusted", value: true })))
+      .status,
+    200
+  );
+  assert.equal(admit().provider, provider);
+  const removed = await route.DELETE(
+    new Request(
+      `http://localhost/api/model-capability-overrides?target=vllm/${model}&key=fully_trusted`
+    )
+  );
+  assert.equal(removed.status, 200);
+  assert.throws(() => admit());
+});
