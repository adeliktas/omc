+});
+
+test("revoked flag after parsing starts refuses before upstream", async (t) => {
+  grant();
+  let network = 0;
+  t.mock.method(http, "request", () => {
+    network++;
+    throw new Error("must not connect");
+  });
+  const request = req();
+  const body = request.body;
+  Object.defineProperty(request, "body", {
+    get() {
+      flags.setModelCapabilityOverride(`${provider}/Qwen3.8-27B-FP8`, "fully_trusted", false);
+      return body;
+    },
+  });
+  assert.equal((await POST(request)).status, 503);
+  assert.equal(network, 0);
+  untouched();
+});
+
+test("owned concurrency slot refuses another body and releases after cancellation", async (t) => {
+  grant();
+  let started!: () => void;
+  const pending = new Promise<void>((resolve) => {
+    started = resolve;
+  });
+  t.mock.method(http, "request", (...args: unknown[]) => {
+    const options = args[1] as { signal: AbortSignal };
+    const socket = Object.assign(new EventEmitter(), {
+      end() {
+        started();
+      },
+    });
+    options.signal.addEventListener(
+      "abort",
+      () => socket.emit("error", new Error("synthetic cancelled")),
+      { once: true }
+    );
+    return socket as unknown as http.ClientRequest;
+  });
+  const controller = new AbortController();
+  const first = POST(new Request(req(), { signal: controller.signal }));
+  await pending;
+  const second = req();
+  Object.defineProperty(second, "body", {
+    get() {
+      throw new Error("busy must not read");
+    },
+  });
+  assert.equal((await POST(second)).status, 503);
+  controller.abort();
+  assert.equal((await first).status, 503);
+  assert.equal((await GET(req("GET"))).status, 200);
+  untouched();
+});
+
+test("unavailable local, redirect, wrong-model/error/oversize replies return fixed refusal without fallback", async (t) => {
+  grant();
+  let network = 0;
+  let reply: unknown = null;
+  let status = 200;
+  t.mock.method(http, "request", (...args: unknown[]) => {
+    network++;
+    if (reply === null) throw new Error("synthetic private diagnostic must not escape");
+    const cb = args[2] as (res: http.IncomingMessage) => void;
+    return Object.assign(new EventEmitter(), {
+      end() {
+        queueMicrotask(() =>
+          cb(
+            Object.assign(
+              Readable.from([
+                Buffer.from(typeof reply === "string" ? reply : JSON.stringify(reply)),
+              ]),
+              { statusCode: status }
+            ) as http.IncomingMessage
+          )
+        );
+      },
+    }) as unknown as http.ClientRequest;
+  });
+  for (const value of [
+    null,
+    { ...output, model: "cloud" },
+    { error: "synthetic private diagnostic" },
+    "x".repeat(262145),
+    "redirect",
+  ]) {
+    reply = value;
+    status = value === "redirect" ? 302 : 200;
+    const response = await POST(req());
+    assert.equal(response.status, 503);
+    const text = await response.text();
+    assert.ok(!text.includes("synthetic private diagnostic"));
+    assert.ok(!text.includes("at /"));
+  }
+  assert.equal(network, 5);
+  untouched();
+});
