+const keys = await load("src/lib/db/apiKeys.ts");
+const nodes = await load("src/lib/db/providers/nodes.ts");
+const flags = await load("src/lib/db/modelCapabilityOverrides.ts");
+const lane = await load("src/lib/db/privateLane.ts");
+const route = await load("src/app/api/v1/private/chat/completions/route.ts");
+const { runAuthzPipeline } = await load("src/server/authz/pipeline.ts");
+const { config } = await load("src/proxy.ts");
+const { getMiddlewareMatchers } = await load(
+  "node_modules/next/dist/build/analysis/get-page-static-info.js"
+);
+const { getMiddlewareRouteMatcher } = await load(
+  "node_modules/next/dist/shared/lib/router/utils/middleware-route-matcher.js"
+);
+const matchers = getMiddlewareMatchers(config.matcher, { basePath: "" });
+const match = getMiddlewareRouteMatcher(matchers);
+await load("node_modules/next/dist/server/node-environment.js");
+const { setupFsCheck } = await load("node_modules/next/dist/server/lib/router-utils/filesystem.js");
+const discovery = path.join(dir, "discovery"),
+  canonical = "/api/v1/private/chat/completions";
+function put(file, data) {
+  const p = path.join(discovery, ".next", file);
+  mkdirSync(path.dirname(p), { recursive: true });
+  writeFileSync(p, typeof data === "string" ? data : JSON.stringify(data));
+}
+put("BUILD_ID", "synthetic-only");
+put("routes-manifest.json", {
+  dataRoutes: [],
+  dynamicRoutes: [],
+  redirects: [],
+  headers: [],
+  onMatchHeaders: [],
+  rewrites: { beforeFiles: [], afterFiles: [], fallback: [] },
+});
+put("prerender-manifest.json", { preview: { previewModeId: "synthetic-preview-id" } });
+put("server/pages-manifest.json", {});
+put("server/functions-config-manifest.json", { functions: { "/_middleware": { matchers } } });
+put("app-path-routes-manifest.json", { [canonical + "/route"]: canonical });
+const filesystem = await setupFsCheck({
+  dev: false,
+  dir: discovery,
+  config: { distDir: ".next", basePath: "", output: "standalone", experimental: {} },
+});
+const { default: serverModule } = await load("node_modules/next/dist/server/next-server.js");
+const NextServer = serverModule.default ?? serverModule;
+const { adapter } = await load("node_modules/next/dist/server/web/adapter.js");
+const { getCloneableBody } = await load("node_modules/next/dist/server/body-streams.js");
+const { NodeNextRequest, NodeNextResponse } = await load(
+  "node_modules/next/dist/server/base-http/node.js"
+);
+const { addRequestMeta } = await load("node_modules/next/dist/server/request-meta.js");
+const { NextRequestAdapter, signalFromNodeResponse } = await load(
+  "node_modules/next/dist/server/web/spec-extension/adapters/next-request.js"
+);
+after(() => {
+  core.resetDbInstance();
+  rmSync(dir, { recursive: true, force: true });
+});
+const provider = "openai-compatible-chat-v4-framework";
+await nodes.createProviderNode({
+  id: provider,
+  prefix: "vllm",
+  name: "Synthetic",
+  type: "openai-compatible",
+  baseUrl: "http://192.0.2.10:8000/v1",
+});
+core
+  .getDbInstance()
+  .prepare(
+    "INSERT INTO provider_connections (id,provider,is_active,created_at,updated_at) VALUES (?,?,1,datetime('now'),datetime('now'))"
+  )
+  .run("synthetic-v4-connection", provider);
+flags.setModelCapabilityOverride(`${provider}/${lane.PRIVATE_LANE_MODEL}`, "fully_trusted", true);
+const key = await keys.createApiKey("Synthetic v4", "synthetic-machine");
+for (const [upload, pathname] of [
+  ["oversized", "/v1/private/chat/completions"],
+  ["unfinished-valid-prefix", "/v1/private/chat/completions"],
+  ["oversized", "/api/v1/%70rivate/chat/completions"],
+  ["unfinished-valid-prefix", "/api/v1/private%2fchat/completions"],
+])
+  test(`private-lane actual framework selection refuses ${upload} on ${pathname} before EOF`, async (t) => {
+    let handlerEntries = 0,
+      middlewareFinished = false,
+      dispatches = 0,
+      received = false,
+      status = 0;
+    const native = http.request;
+    t.mock.method(http, "request", () => {
+      dispatches++;
+      throw new Error("no real dispatch authorized");
+    });
+    const middlewareModule = {
+      default: adapter,
+      proxy: async (r) => {
+        const result = await runAuthzPipeline(r, { enforce: true });
+        assert.equal(result.headers.get("x-middleware-next"), "1");
+        middlewareFinished = true;
+        return result;
+      },
+    };
+    // Build/module discovery alone is stubbed; installed Next runMiddleware/adapter/body finalization execute.
+    const facade = {
+      renderOpts: { previewProps: { previewModeId: "synthetic-nonempty-preview-id" } },
