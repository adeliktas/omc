+import { test, after } from "node:test";
+import assert from "node:assert/strict";
+import { mkdtempSync, rmSync } from "node:fs";
+import { tmpdir } from "node:os";
+import { join } from "node:path";
+
+const dir = mkdtempSync(join(tmpdir(), "prompt-routing-"));
+process.env.DATA_DIR = dir;
+const { resetDbInstance } = await import("@/lib/db/core.ts");
+const { orderPromptAwareTargets } =
+  await import("@omniroute/open-sse/services/combo/promptAwareRouting.ts");
+const { resolveAutoStrategyOrder } =
+  await import("@omniroute/open-sse/services/combo/resolveAutoStrategy.ts");
+const { rrCounters } = await import("@omniroute/open-sse/services/combo/rrState.ts");
+const { getTaskFitnessWithSource, setUserFitnessOverride, clearUserFitnessOverride } =
+  await import("@omniroute/open-sse/services/autoCombo/taskFitness.ts");
+const { normalizeScoringWeights } =
+  await import("@omniroute/open-sse/services/autoCombo/scoring.ts");
+const { mapIntentToTaskType } = await import("@omniroute/open-sse/services/combo/autoStrategy.ts");
+const { classifyWithConfig } = await import("@omniroute/open-sse/services/intentClassifier.ts");
+import type {
+  AutoProviderCandidate,
+  ResolvedComboTarget,
+} from "@omniroute/open-sse/services/combo/types.ts";
+import type { ScoringWeights } from "@omniroute/open-sse/services/autoCombo/scoring.ts";
+
+after(() => {
+  resetDbInstance();
+  rmSync(dir, { recursive: true, force: true });
+});
+const target = (provider: string, model: string, connectionId = provider): ResolvedComboTarget => ({
+  kind: "model",
+  stepId: connectionId,
+  executionKey: `${provider}/${model}@${connectionId}`,
+  modelStr: `${provider}/${model}`,
+  provider,
+  providerId: provider,
+  connectionId,
+  weight: 1,
+  label: null,
+});
+const targets = [
+  target("codex", "gpt-5.5"),
+  target("bridge", "sonnet"),
+  target("neuralwatt", "glm-5.3-flash"),
+];
+const candidate = (t: ResolvedComboTarget): AutoProviderCandidate => ({
+  ...t,
+  model: t.modelStr.split("/").slice(1).join("/"),
+  quotaRemaining: 100,
+  quotaTotal: 100,
+  circuitBreakerState: "CLOSED",
+  costPer1MTokens: 1,
+  p95LatencyMs: 100,
+  latencyStdDev: 0,
+  errorRate: 0,
+});
+const base = () => ({
+  comboName: "test",
+  targets,
+  candidates: targets.map(candidate),
+  intent: "code",
+  intentEnabled: true,
+  taskType: "coding",
+  weights: normalizeScoringWeights({ taskFit: 1 } as ScoringWeights),
+});
+
+test("same eligible pool chooses code specialist vs analysis model based on prompt intent", () => {
+  const coding = orderPromptAwareTargets(base());
+  const analysis = orderPromptAwareTargets({
+    ...base(),
+    intent: "reasoning",
+    taskType: "analysis",
+  });
+  assert.equal(coding.targets[0].provider, "codex");
+  assert.equal(analysis.targets[0].provider, "bridge");
+  assert.match(coding.reason, /prompt-aware/);
+  assert.equal(new Set(coding.targets.map((t) => t.executionKey)).size, targets.length);
+});
+test("math maps to analysis rather than generic default", () => {
+  assert.equal(mapIntentToTaskType("math"), "analysis");
+});
+test("compatible Claude bare-family and Codex provider fitness use existing family table", () => {
+  assert.equal(
+    getTaskFitnessWithSource("sonnet", "analysis").score,
+    getTaskFitnessWithSource("claude-sonnet", "analysis").score
+  );
+  assert.equal(
+    getTaskFitnessWithSource("gpt-5.5", "coding", "codex").score,
+    getTaskFitnessWithSource("codex", "coding").score
+  );
+  assert.equal(getTaskFitnessWithSource("gpt-5.5", "coding", "openai").source, "wildcard_boost");
+});
+test("explicit fitness override retains precedence over alias heuristics", () => {
+  setUserFitnessOverride("sonnet", "analysis", 0.12);
+  assert.equal(getTaskFitnessWithSource("sonnet", "analysis").score, 0.12);
+  clearUserFitnessOverride("sonnet", "analysis");
+});
+test("unknown or disabled classification rotates the same pool", () => {
+  rrCounters.clear();
+  const a = orderPromptAwareTargets({ ...base(), intent: "medium" });
+  const b = orderPromptAwareTargets({ ...base(), intentEnabled: false });
+  assert.equal(a.targets[0].provider, "codex");
+  assert.equal(b.targets[0].provider, "bridge");
+  assert.match(b.reason, /round-robin/);
+});
+test("scoring failure rotates without returning blocked quotas or injected account", () => {
+  rrCounters.clear();
+  const input = base();
+  input.candidates[0].quotaCutoffBlocked = true;
+  input.candidates.push(candidate(target("unapproved", "model")));
+  const decision = orderPromptAwareTargets(input, () => {
+    throw new Error("scoring unavailable");
+  });
+  assert.deepEqual(
+    decision.targets.map((t) => t.provider),
+    ["bridge", "neuralwatt"]
+  );
+});
+test("empty/invalid scorer result falls back safely", () => {
+  assert.match(orderPromptAwareTargets(base(), () => []).reason, /round-robin/);
+  assert.match(
+    orderPromptAwareTargets(base(), () => [{ target: target("evil", "unknown"), score: 99 }])
+      .reason,
+    /round-robin/
+  );
+});
+test("round-robin tail remains after prompt-selected primary", () => {
+  rrCounters.clear();
+  const first = orderPromptAwareTargets(base());
+  const second = orderPromptAwareTargets(base());
+  assert.equal(first.targets[0].provider, "codex");
+  assert.equal(second.targets[0].provider, "codex");
+  assert.equal(first.targets.length, 3);
+});
+test("strict budget rejection is not caught as round-robin fallback", () => {
+  assert.throws(
+    () => orderPromptAwareTargets({ ...base(), budgetCap: 0.00001, budgetFallback: "strict" }),
+    /budget/i
+  );
+});
+test("budget excludes unaffordable smarter target", () => {
+  const input = base();
+  input.candidates[0].costPer1MTokens = 100;
+  const result = orderPromptAwareTargets({ ...input, budgetCap: 0.002, budgetFallback: "strict" });
+  assert.ok(result.targets.every((t) => t.provider !== "codex"));
+});
+test("account pin cannot be broadened by scorer/candidate builder", () => {
+  const t = target("codex", "gpt-5.5", "approved-account");
+  const result = orderPromptAwareTargets({
+    ...base(),
+    targets: [t],
+    candidates: [candidate(target("codex", "gpt-5.5", "other-account"))],
+  });
+  assert.equal(result.targets.length, 0);
+});
+test("substring false positives and vague writing do not classify every prompt as code", () => {
+  for (const prompt of [
+    "Define gravity",
+    "Write a poem about the ocean",
+    "Describe a classical constellation",
+  ]) {
+    assert.notEqual(classifyWithConfig(prompt, { enabled: true }), "code", prompt);
+  }
+  assert.equal(
+    classifyWithConfig("Write a Python function to parse JSON", { enabled: true }),
+    "code"
+  );
+});
+test("actual auto resolver uses prompt-aware primary and logs only decision metadata", async () => {
+  const logs: string[] = [];
+  const result = await resolveAutoStrategyOrder({
+    orderedTargets: targets,
+    body: { messages: [{ role: "user", content: "Implement a Python function" }] },
+    combo: {
+      name: "smart",
+      models: [],
+      config: {
+        auto: {
+          promptAwareRouting: true,
+          candidatePool: targets.map((t) => t.provider),
+          weights: { taskFit: 1 },
+        },
+      },
+    },
+    settings: null,
+    config: {},
+    resilienceSettings: { quotaPreflight: { enabled: false } } as never,
+    log: { info: (...args: unknown[]) => logs.push(args.join(" ")), warn() {} },
+    buildAutoCandidates: async () => targets.map(candidate),
+  });
+  assert.ok("orderedTargets" in result);
+  if ("orderedTargets" in result) {
+    assert.equal(result.orderedTargets[0].provider, "codex");
+    assert.equal(result.autoUsedExplicitRouter, true);
+  }
+  assert.ok(logs.some((line) => line.includes("prompt-aware")));
+  assert.ok(logs.every((line) => !line.includes("Implement a Python function")));
+});
