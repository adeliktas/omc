+test("work inherited from a released refresh must acquire the lane again", async () => {
+  __resetRefreshSerializerForTest();
+  let releaseDeferred!: () => void;
+  let releaseSibling!: () => void;
+  let started!: () => void;
+  const deferredGate = new Promise<void>((resolve) => {
+    releaseDeferred = resolve;
+  });
+  const siblingGate = new Promise<void>((resolve) => {
+    releaseSibling = resolve;
+  });
+  const siblingStarted = new Promise<void>((resolve) => {
+    started = resolve;
+  });
+  let deferred!: Promise<void>;
+  const order: string[] = [];
+  await serializeRefresh("codex", async () => {
+    deferred = deferredGate.then(() =>
+      serializeRefresh("codex", async () => {
+        order.push("deferred");
+      })
+    );
+  });
+  const sibling = serializeRefresh("codex", async () => {
+    started();
+    await siblingGate;
+    order.push("sibling");
+  });
+  await siblingStarted;
+  releaseDeferred();
+  await delay(10);
+  assert.deepEqual(order, []);
+  releaseSibling();
+  await Promise.all([sibling, deferred]);
+  assert.deepEqual(order, ["sibling", "deferred"]);
+});
