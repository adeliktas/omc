+
+/** Only reorder already-authorized, compatible, quota-eligible account targets. */
+export function orderPromptAwareTargets(
+  input: {
+    comboName: string;
+    targets: ResolvedComboTarget[];
+    candidates: AutoProviderCandidate[];
+    taskType: string;
+    intent: string;
+    intentEnabled: boolean;
+    weights: ScoringWeights;
+    manifestHint?: RoutingHint | null;
+    budgetCap?: number;
+    budgetFallback?: "strict" | "cheapest";
+  },
+  score = scoreAutoTargets
+): { targets: ResolvedComboTarget[]; reason: string } {
+  let candidates = input.candidates.filter((candidate) => !candidate.quotaCutoffBlocked);
+  // Match the existing auto engine's 1,000-token routing estimate. This is NOT
+  // an enforceable request/spend ceiling; provider admission still owns that.
+  if (input.budgetCap) {
+    const affordable = candidates.filter(
+      (candidate) => candidate.costPer1MTokens / 1000 <= input.budgetCap!
+    );
+    if (affordable.length) candidates = affordable;
+    else if (input.budgetFallback === "strict") {
+      throw new BudgetExceededError(
+        input.budgetCap,
+        Math.min(...candidates.map((candidate) => candidate.costPer1MTokens / 1000))
+      );
+    } else {
+      candidates = [...candidates]
+        .sort((a, b) => a.costPer1MTokens - b.costPer1MTokens)
+        .slice(0, 1);
+    }
+  }
+  const eligible = candidates.flatMap((candidate) => {
+    const base = input.targets.find(
+      (target) =>
+        target.provider === candidate.provider &&
+        target.modelStr === candidate.modelStr &&
+        (!target.connectionId || target.connectionId === candidate.connectionId)
+    );
+    return base
+      ? [
+          {
+            ...base,
+            executionKey: candidate.executionKey,
+            connectionId: candidate.connectionId ?? base.connectionId,
+          },
+        ]
+      : [];
+  });
+  if (!eligible.length) return { targets: [], reason: "no eligible account targets" };
+
+  const key = `${input.comboName}:prompt-fallback`;
+  if (!rrCounters.has(key) && rrCounters.size >= MAX_RR_COUNTERS) {
+    const oldest = rrCounters.keys().next().value;
+    if (oldest !== undefined) rrCounters.delete(oldest);
+  }
+  const start = (rrCounters.get(key) || 0) % eligible.length;
+  rrCounters.set(key, (start + 1) % eligible.length);
+  const fallback = [...eligible.slice(start), ...eligible.slice(0, start)];
+  if (!input.intentEnabled || input.intent === "medium") {
+    return { targets: fallback, reason: "round-robin: intent disabled or unclassified" };
+  }
+  try {
+    const ranked = score(eligible, candidates, input.taskType, input.weights, input.manifestHint);
+    const best = ranked.find((entry) => Number.isFinite(entry.score))?.target;
+    // Scoring cannot inject a target outside the validated pool.
+    const winner = best && eligible.find((target) => target.executionKey === best.executionKey);
+    if (winner)
+      return {
+        targets: [
+          winner,
+          ...fallback.filter((target) => target.executionKey !== winner.executionKey),
+        ],
+        reason: `prompt-aware: intent=${input.intent} task=${input.taskType}; round-robin fallback`,
+      };
+  } catch {
+    // ponytail: synchronous intent/fitness scoring; semantic classifier can be
+    // added if measured misroutes justify its extra latency and model usage.
+  }
+  return { targets: fallback, reason: "round-robin: scoring unavailable" };
+}
